{
  /*
  ##############################################################################
  # DEVELOPMENT CONTAINER CONFIGURATION                                        #
  ##############################################################################
  */
  "name": "Dev Container",

  /*
  ##############################################################################
  # DOCKER COMPOSE CONFIGURATION                                               #
  ##############################################################################
  # These keys give the source files for Docker Compose. They also give the
  # first service to connect to, and the workspace path in the container.
  #
  # See: https://containers.dev/implementors/json_reference/#compose-specific
  */
  "service": "devcontainer",
  "dockerComposeFile": ["compose.yaml", "compose.extend.yaml"],
  "workspaceFolder": "/workspace",

  /*
  ##############################################################################
  # FEATURES                                                                   #
  ##############################################################################
  # A feature adds more tools to the container and sets them up.
  #
  # See: https://containers.dev/features
  */
  "features": {
    /* ----------------------------------------------------------------------
       NIX FEATURE
       This feature adds the Nix package manager to the development
       container. Nix gives you the same packages and the same environment
       again.

       See: https://github.com/devcontainers/features/tree/main/src/nix
       See: https://nixos.org/
       ---------------------------------------------------------------------- */
    "ghcr.io/devcontainers/features/nix:1": {
      "version": "2.34.0",
      "extraNixConfig": "extra-experimental-features = nix-command flakes"
    }
  },

  /*
  ##############################################################################
  # FORWARD PORTS                                                              #
  ##############################################################################
  # These keys give the ports that go from the container to the host machine.
  # Thus you can get access to the services in the container.
  #
  # See: https://containers.dev/implementors/json_reference/#general-properties
  */
  "forwardPorts": [
    "zot-registry:5000"
  ],
  "portsAttributes": {
    "zot-registry:5000": {
      "label": "Zot Registry",
      "onAutoForward": "notify"
    }
  },

  /*
  ##############################################################################
  # CUSTOMIZATIONS                                                             #
  ##############################################################################
  # These keys change the development container environment. They set the
  # Visual Studio Code extensions and the Visual Studio Code settings.
  #
  # See: https://containers.dev/supporting#visual-studio-code
  */
  "customizations": {
    "vscode": {
      /* --------------------------------------------------------------------
         VISUAL STUDIO CODE EXTENSIONS
         The development container adds these Visual Studio Code extensions
         automatically.

         See: https://marketplace.visualstudio.com/vscode
         -------------------------------------------------------------------- */
      "extensions": [
        "golang.go",
        "jnoortheen.nix-ide",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "task.vscode-task"
      ],

      /* --------------------------------------------------------------------
         VISUAL STUDIO CODE SETTINGS
         The development container applies these Visual Studio Code settings
         automatically.

         See: https://code.visualstudio.com/docs/configure/settings
         -------------------------------------------------------------------- */
      "settings": {
        /* Editor Display & Behavior */
        "editor.rulers": [100],
        "editor.quickSuggestions": {
          "strings": "on"
        },
        "files.autoSave": "afterDelay",

        /* Nix Language Support */
        "nix.enableLanguageServer": true,
        "nix.serverPath": "nixd",
        "nix.serverSettings": {
          "nixd": {
            "formatting": {
              "command": ["nixfmt"]
            }
          }
        }
      }
    }
  },

  /*
  ##############################################################################
  # LIFECYCLE SCRIPTS                                                          #
  ##############################################################################
  # These commands run at given points in the life of the development
  # container. Thus you can do your own setup steps and configuration steps.
  #
  # See: https://containers.dev/implementors/json_reference/#lifecycle-scripts
  */

  /* ------------------------------------------------------------------------
     ON CREATE COMMAND
     Three commands complete the setup of a new dev container. This command
     is the first of the three. The other two are 'updateContentCommand' and
     'postCreateCommand'. These commands run in the container immediately
     after it starts the first time.

     See: https://containers.dev/implementors/json_reference/#lifecycle-scripts
     ------------------------------------------------------------------------ */
  "onCreateCommand": {
    /* ----------------------------------------------------------------------
       NIX PROFILE ADD
       This command adds the 'devEnvironment' from the 'flake.nix' to the Nix
       profile. Thus the container has each development dependency.
       ---------------------------------------------------------------------- */
    "nix-profile-add--devEnvironment": "git add \"flake.nix\" && nix profile add .#devEnvironment"
  },

  /* ------------------------------------------------------------------------
     UPDATE CONTENT COMMAND
     This command is the second of the three commands that complete the setup
     of a new dev container. It runs in the container after 'onCreateCommand'.
     It runs each time the source tree gets new content during the setup.

     See: https://containers.dev/implementors/json_reference/#lifecycle-scripts
     ------------------------------------------------------------------------ */
  "updateContentCommand": {
    /* ----------------------------------------------------------------------
       GIT UPDATE INDEX --SKIP-WORKTREE
       This command marks the 'compose.extend.yaml' file as 'skip-worktree'
       in git. Then git ignores each change to the file. Thus you can change
       the file on your machine, and the upstream repository stays the same.

       See: https://til.stefan-dev.de/git/git-ignore-tracked-files/
       ---------------------------------------------------------------------- */
    "git-update-index--skip-worktree": "git update-index --skip-worktree .devcontainer/compose.extend.yaml"
  }
}